DATABASE_URL=postgresql://postgres:your-password@localhost:5432/fightersarena
JWT_PRIVATE_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development sign-in code. The OTP routes are disabled in production.
DEV_OTP_CODE=123456

# S3-compatible object storage. Keep these server-only; never add NEXT_PUBLIC_.
# Optional for AWS S3; required for Railway, MinIO, R2, and other S3-compatible providers.
# Until these are set, uploads and media reads return 503 STORAGE_NOT_CONFIGURED.
AWS_ENDPOINT_URL=https://your-s3-endpoint.example.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=fighters-arena-media
AWS_DEFAULT_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true

# Seed superadmin account (src/db/seed.ts). SEED_SUPERADMIN_PASSWORD is required
# when running `npm run db:seed`; there is no default. The password is only used
# when the account is first created, so a re-run never resets it.
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password

# Password given to players created by `npm run db:seed:content`.
# Each player must replace it the first time they sign in.
SEED_GAMER_PASSWORD=123456
